# 로컬에서 `npm run generate`를 테스트할 때 사용하세요.
# 이 파일을 복사해서 .env로 만들고 실제 값을 채운 뒤 실행 전에 로드하세요:
#   set -a && source .env && set +a && npm run generate
#
# GitHub Actions에서는 이 값들을 Secrets/Variables로 등록합니다 (README 참고).

ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 선택: 비워두면 scripts/lib/anthropic.mjs 안의 기본 모델을 사용합니다.
CLAUDE_MODEL=

# 이 블로그는 실존 연예인의 초상권/저작권 문제 때문에 스톡 사진 자동 검색(Pexels)을 쓰지 않습니다.
# 대신 아래 GEMINI_API_KEY를 채우면, 글이 생성될 때 필요한 이미지들을 Gemini가 자동으로
# 만들어서 바로 폴더에 넣어줍니다 (사람이 손댈 필요 없음 — PR에 이미지까지 이미 포함되어 옴).
# 무료 발급: https://aistudio.google.com/apikey (Google 계정만 있으면 무료 티어로 시작 가능)
# 비워두면 예전처럼 프롬프트만 만들어지고, npm run photos 실행 시 Bing Image Creator
# (무료) 링크와 함께 보여줍니다 — 사람이 직접 만들어서 넣으면 됩니다. 자세한 건 README 참고.
GEMINI_API_KEY=

# 선택: 비워두면 scripts/lib/gemini-images.mjs 안의 기본 모델을 사용합니다.
GEMINI_MODEL=

# 선택: 애드센스 승인 후 채우면 광고가 실제로 노출됩니다. (Astro는 PUBLIC_ 접두사가 붙은
# 변수만 클라이언트에 노출하므로 접두사를 반드시 유지하세요)
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_TOP=
PUBLIC_ADSENSE_SLOT_BOTTOM=
